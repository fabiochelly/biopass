{
  "manifest_version": 3,
  "name": "BioPass",
  "version": "1.2.0",
  "description": "Remplissage automatique des mots de passe depuis votre serveur BioPass.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "BioPass",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "permissions": ["storage", "unlimitedStorage", "alarms", "clipboardWrite", "contextMenus", "offscreen", "scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+Y" },
      "description": "Ouvrir BioPass"
    },
    "autofill": {
      "suggested_key": { "default": "Ctrl+Space" },
      "description": "Remplir le compte du site (appuyer à nouveau : compte suivant)"
    },
    "generate": {
      "suggested_key": { "default": "Ctrl+Shift+G" },
      "description": "Copier un mot de passe aléatoire généré"
    }
  }
}
