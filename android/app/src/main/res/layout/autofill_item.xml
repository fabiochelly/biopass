<?xml version="1.0" encoding="utf-8"?>
<!-- Suggestion de la liste déroulante (RemoteViews), compacte, sur une ligne :
     icône · identifiant (texte principal) · nom en petit. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="44dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="14dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/af_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_logo" />

    <!-- Pastille de couleur de l'entrée (même couleur que dans la barre du clavier) -->
    <ImageView
        android:id="@+id/af_dot"
        android:layout_width="20dp"
        android:layout_height="12dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/dot"
        android:visibility="gone" />

    <TextView
        android:id="@+id/af_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:singleLine="true"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/af_sub"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="12sp" />
</LinearLayout>
